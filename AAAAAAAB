<div class="card">

    <!-- MAIN HEADER -->

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>
            Account Details
        </strong>

        <export-excel-button
            title="Download Pre-Disclosure Template"
            @click="download_line_template()">
        </export-excel-button>

    </div>


    <div class="card-body p-2">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >


            <!-- ACCORDION -->

            <div
                class="accordion"
                id="accountAccordion"
            >


                <!-- ACCOUNT -->

                <div
                    v-for="(line, index) in lines"
                    :key="'line-' + index"
                    class="accordion-item"
                >


                    <!-- ACCORDION HEADER -->

                    <div
                        class="accordion-header d-flex align-items-center"
                        :id="'heading-' + index"
                    >

                        <button
                            class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            :data-bs-target="'#collapse-' + index"
                            aria-expanded="false"
                            :aria-controls="'collapse-' + index"
                        >

                            <strong>
                                Account #[[ index + 1 ]]
                            </strong>

                        </button>


                        <!-- ACTION BUTTONS -->

                        <div
                            class="btn-group me-2"
                            @click.stop
                        >

                            <template-button
                                :size="18"
                                @click="copy_line(line, index)">
                            </template-button>


                            <delete-button
                                :size="18"
                                @delete-confirm="delete_line(line)">
                            </delete-button>

                        </div>

                    </div>


                    <!-- ACCORDION BODY -->

                    <div
                        :id="'collapse-' + index"
                        class="accordion-collapse collapse"
                        :aria-labelledby="'heading-' + index"
                        data-bs-parent="#accountAccordion"
                    >

                        <div class="accordion-body">


                            <!-- =============================
                                 ROW 1
                                 MAIN DETAILS - 6 FIELDS
                            ============================== -->

                            <div class="row g-2 mb-3">

                                {% for field in predisclosure_line_form.visible_fields %}

                                    {% if forloop.counter <= 6 %}

                                        <div
                                            v-if="showField('{{ field.name }}')"
                                            class="col-md-2"
                                        >

                                            <label class="form-label small mb-1">

                                                {{ field.label }}

                                            </label>


                                            {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                        </div>

                                    {% endif %}

                                {% endfor %}

                            </div>


                            <!-- =============================
                                 ROW 2
                                 REMAINING NORMAL FIELDS
                            ============================== -->

                            <div class="row g-2 mb-3">

                                {% for field in predisclosure_line_form.visible_fields %}

                                    {% if forloop.counter > 6 and forloop.counter <= 12 %}

                                        <div
                                            v-if="showField('{{ field.name }}')"
                                            class="col-md-3"
                                        >

                                            <label class="form-label small mb-1">

                                                {{ field.label }}

                                            </label>


                                            {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                        </div>

                                    {% endif %}

                                {% endfor %}

                            </div>


                            <!-- =============================
                                 REMAINING FIELDS
                            ============================== -->

                            <div class="row g-2">

                                {% for field in predisclosure_line_form.visible_fields %}

                                    {% if forloop.counter > 12 %}

                                        <div
                                            v-if="showField('{{ field.name }}')"
                                            class="col-md-4"
                                        >

                                            <label class="form-label small mb-1">

                                                {{ field.label }}

                                            </label>


                                            {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                        </div>

                                    {% endif %}

                                {% endfor %}

                            </div>


                        </div>

                    </div>

                </div>

            </div>

        </form>


        <!-- ADD ACCOUNT -->

        <div class="mt-3">

            <add-button
                :size="18"
                @click="add_line()">
            </add-button>

        </div>

    </div>

</div>
