from django.core.management.base import BaseCommand
from django.db import transaction

from pricerequest.models import (
    Ticket,
    TicketLine,
    TicketStatus,
    ContactEmails,
    AnnouncementMailLink,
)


class Command(BaseCommand):
    help = "Backfill metadata fields from legacy audit fields."

    def handle(self, *args, **options):

        self.stdout.write(self.style.NOTICE("Starting metadata migration..."))

        with transaction.atomic():

            # -------------------------------------------------------
            # Ticket
            # -------------------------------------------------------
            self.stdout.write("Migrating Ticket...")

            updated = 0

            for ticket in Ticket.objects.iterator():

                changed = False

                if not ticket.meta_created_by:
                    ticket.meta_created_by = ticket.created_by
                    changed = True

                if not ticket.meta_created_date:
                    ticket.meta_created_date = ticket.modified
                    changed = True

                if not ticket.meta_edited_by:
                    ticket.meta_edited_by = ticket.created_by
                    changed = True

                if not ticket.meta_edited_date:
                    ticket.meta_edited_date = ticket.modified
                    changed = True

                if changed:
                    ticket.save(
                        update_fields=[
                            "meta_created_by",
                            "meta_created_date",
                            "meta_edited_by",
                            "meta_edited_date",
                        ]
                    )
                    updated += 1

            self.stdout.write(
                self.style.SUCCESS(
                    f"Ticket : {updated} record(s) updated."
                )
            )

            # -------------------------------------------------------
            # TicketLine
            # -------------------------------------------------------
