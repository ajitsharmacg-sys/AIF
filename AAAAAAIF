def get_conflicting_aif_ids(aif):
    base_sql = """
        SELECT
            a.aif_id,
            a.start_date,
            a.end_date,
            l.mercury_code,
            l.promotional_elp,
            {customer_column}
        FROM aif_aif a
        INNER JOIN aif_aiflines l ON l.aif_id = a.aif_id

        INNER JOIN aif_aiflines current_l
            ON current_l.aif_id = %s
            AND current_l.mercury_code = l.mercury_code

        {customer_join}

        WHERE
            a.aif_id != %s
            AND a.nso = %s
            AND a.end_date >= %s
            AND (
                SELECT TOP 1 status
                FROM aif_aifstatus s
                WHERE s.aif_id = a.aif_id
                ORDER BY s.id DESC
            ) != %s
            {extra_condition}
    """

    # ALL NSO CASE (NO CUSTOMER)
    if aif.is_all_nso_enabled:
        customer_column = "NULL as customer"
        customer_join = ""
        extra_condition = "AND a.is_all_nso_enabled = 1"

        params = [
            aif.aif_id,     # current_l
            aif.aif_id,     # exclude self
            aif.nso,
            aif.start_date,   # for a.end_date >= current.start_date
            AifStatusChoices.INVALID,      # exclude invalid AIFs
        ]

    # CUSTOMER CASE
    else:
        customer_column = "c.oracle_cust_number as customer"
        customer_join = """
            INNER JOIN aif_aifcustomerlines c ON c.aif_id = a.aif_id
            INNER JOIN aif_aifcustomerlines current_c
                ON current_c.aif_id = %s
                AND current_c.oracle_cust_number = c.oracle_cust_number
        """
        extra_condition = ""

        params = [
            aif.aif_id,     # current_l
            aif.aif_id,     # current_c
            aif.aif_id,     # exclude self
            aif.nso,
            aif.start_date, # >
            AifStatusChoices.INVALID,      # exclude invalid AIFs
        ]

    sql = base_sql.format(
        customer_column=customer_column,
        customer_join=customer_join,
        extra_condition=extra_condition,
    )

    with connection.cursor() as cursor:
        cursor.execute(sql, params)
        columns = [col[0] for col in cursor.description]
        rows = cursor.fetchall()

    return [dict(zip(columns, row)) for row in rows]

    
class AifByStatusFilter(filters.BaseFilterBackend):
    """
    Custom filter to filter Contract based on its last status.
    """

    def filter_queryset(self, request, queryset, view):
        aif_status = request.query_params.get("aif_status", None)
        if aif_status:
            # validation
            if aif_status in AifStatusChoices:
                aif_statuses = AifStatus.objects.raw(
                    f"""
                                        SELECT [id],[meta_created_date],[status],[comment],[aif_id],[meta_created_by_id]  FROM
                                        (SELECT [aif_id], MAX([id]) AS 'last_status_id' FROM [dbo].[aif_aifstatus]
                                        GROUP BY [aif_id]) AS A
                                        LEFT JOIN
                                        (SELECT [id], [meta_created_date], [status],[comment],[meta_created_by_id] FROM [dbo].[aif_aifstatus]) AS B
                                        ON A.last_status_id = B.id
                                        WHERE [status] = '{aif_status}'
                                        """
                )
                aif_ids = list(aif_statuses.values_list("aif_id", flat=True))
                queryset = queryset.filter(aif_id__in=aif_ids)

        return queryset


def aif_url(request: HttpRequest, aif_id: str):
    return f"{request.build_absolute_uri('/aifmgmt/aif/')}{aif_id}/"


class AifView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]
    filter_backends = [
        DjangoFilterBackend,
        filters.SearchFilter,
        filters.OrderingFilter,
        AifByStatusFilter,
    ]
    pagination_class = StandardPagination
    filterset_fields = {
        "aif_id": ["exact"],
        "meta_created_date": ["exact", "gt", "lt"],
    }
    search_fields = ["aif_id","nso"]

    @action(detail=True, methods=["get"])
    def conflicts(self, request, pk=None):
        aif = self.get_object()
        conflict_ids = get_conflicting_aif_ids(aif)
        return Response({
            "conflicting_rows": conflict_ids
        })

    def get_serializer_class(self):
        if self.action in ["create", "update", "partial_update", "destroy"]:
            return AifWriteSerializer
        return AifReadSerializer

    def perform_create(self, serializer):
        instance: Aif = serializer.save(meta_created_by=self.request.user,meta_edited_date=timezone.now())
        AifStatus.objects.create(
            aif=instance,
            status=AifStatusChoices.DRAFT,
            meta_created_by=self.request.user,
        )

        return instance
        
    def perform_update(self, serializer):
        current_status = get_aif_status(
            self.kwargs["pk"]
        )

        if current_status.status not in [
            AifStatusChoices.DRAFT,
            AifStatusChoices.INVALID,
        ]:
            raise PermissionDenied(
                "You can't edit this AIF!"
            )

        instance = serializer.save(
            meta_edited_date=timezone.now(),
            meta_edited_by=self.request.user,
        )

        if current_status.status == AifStatusChoices.INVALID:
            update_aif_workflow(
                request=self.request,
                aif=instance,
                new_status=AifStatusChoices.DRAFT,
            )
            update_all_lines_status(
                status=AifLineStatusChoices.DRAFT,
                aif=instance,
                request=self.request,
            )

        return instance

    def get_queryset(self):
        if self.request.user.groups.filter(name=NSO_USER).exists():
            return Aif.objects.filter(
                nso__in=Organization.objects.filter(
                    cluster=self.request.user.cluster
                ).values_list("organization_name", flat=True)
            )

        elif self.request.user.groups.filter(name=PSBD_TEAM_USER).exists():

            allowed_product_groups = AifApprover.objects.filter(
                approver=self.request.user
            ).values_list(
                "product_group",
                flat=True
            )

            return Aif.objects.filter(
                aif_lines__product_group__in=allowed_product_groups
            ).distinct()

        return Aif.objects.all()


