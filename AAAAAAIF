        ]

        current_status = (
            AifLineStatus.objects
            .filter(aif_line=aif_line)
            .order_by("-meta_created_date")
            .first()
        )

        if not current_status:
            raise PermissionDenied(
                "Current line status was not found."
            )

        user_roles = get_user_roles(
            self.request.user
        )

        if not is_valid_line_transition(
            current_status=current_status.status,
            new_status=new_status,
        ):
            raise PermissionDenied(
                f"Invalid line status transition from "
                f"{current_status.status} to {new_status}."
            )

        if not is_role_allowed_for_line_status(
            user_roles=user_roles,
            target_status=new_status,
        ):
            raise PermissionDenied(
                "You are not allowed to perform "
                "this line status transition."
            )

        instance: AifLineStatus = serializer.save(
            meta_created_by=self.request.user,
        )

