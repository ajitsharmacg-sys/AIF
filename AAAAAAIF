def build_sales_ops_cc(cc_mail):
    if not cc_mail:
        return cc_mail
    
    configured_emails = list(
        AifSalesOpsEmail.objects.values_list(
            "email",
            flat=True,
        )
    )
    emails = []
    if isinstance(cc_mail, str) and cc_mail:
        emails.append(cc_mail)

    emails.extend(configured_emails)

    return ";".join(emails)

def send_aif_status_notification(
    request: HttpRequest,
    aif: Aif,
    new_status: str,
    comment: str,
):
    link = aif_url(request, aif.aif_id)
    cc_mail = get_aif_cc(aif, new_status)
    final_cc = build_sales_ops_cc(cc_mail)
    if new_status == AifStatusChoices.AWAITING_VALIDATION:
        attachment = prepare_open_orders_attachment(aif)
        email_config = OMEmailsConfig.objects.filter(nso=aif.nso).first()
        if email_config and email_config.om_emails:
            if attachment:
                send_email_with_attachments(
                    to=email_config.om_emails,
                    subject=get_om_email_subject(aif),
                    body=build_om_email_body(aif, link),
                    cc=None,
                    attachments=[attachment],
                )
            else:
                send_email(
                    to=email_config.om_emails,
                    subject=get_om_email_subject(aif),
                    body=build_om_email_body(aif, link),
                    cc=None,
                )

        send_email(
            to=aif.meta_created_by.email,
            cc=cc_mail,
            subject=get_aif_email_subject(aif, new_status),
            body=get_aif_email_body(aif, new_status, link, comment),
        )


    if new_status == AifStatusChoices.CLOSED:
        send_email_to_group(
            to=Group.objects.get(name=SALES_OPS_USER),
            subject=get_aif_email_subject(aif, new_status, "validated"),
            body=get_aif_email_body(aif, new_status, link, comment, "validated"),
            cc=final_cc
        )
        send_email_to_group(
            to=Group.objects.get(name=SALES_OPS_USER),
            subject=get_aif_email_subject(aif, new_status, "completed"),
            body=get_aif_email_body(aif, new_status, link, comment, "completed"),
            cc=final_cc
        )
    
    if new_status == AifStatusChoices.COMMERCIALLY_APPROVED:
        send_email_to_group(
            to=Group.objects.get(name=SALES_OPS_USER),
            subject=get_aif_email_subject(aif, new_status),
            body=get_aif_email_body(aif, new_status, link, comment),
            cc=final_cc
        )

    if new_status == AifStatusChoices.INVALID:
        send_email(
            to=aif.meta_created_by.email,
            cc=cc_mail,
            subject=get_aif_email_subject(aif, new_status),
            body=get_aif_email_body(aif, new_status, link, comment),
        )


def update_aif_workflow(
    *,
    request: HttpRequest,
    aif: Aif,
    new_status: str,
    comment: str | None = None,
):
    current_status = get_aif_status(aif).status
    if current_status == new_status:
        return

    if not is_valid_aif_transition(
        current_status=current_status,
        new_status=new_status,
    ):
        raise PermissionDenied(
            f"Invalid AIF status transition from "
            f"{current_status} to {new_status}."
        )

    AifStatus.objects.create(
        aif=aif,
        status=new_status,
        comment=comment,
        meta_created_by=request.user,
    )
    # Update AIF edited info
    Aif.objects.filter(pk=aif.pk).update(
        meta_edited_date=timezone.now(),
        meta_edited_by=request.user,
    )
    
    if new_status == AifStatusChoices.CLOSED:
        update_all_lines_status(
            status=AifLineStatusChoices.CLOSED,
            aif=aif,
            request=request,
        )

    if new_status == AifStatusChoices.PLANNED:
        set_initial_line_status(
            aif,
            request,
        )

        notify_aif_approvers(
            request,
            aif=aif,
            comment=comment,
        )

    if new_status == AifStatusChoices.INVALID:
        reject_all_lines(
            AifLines.objects.filter(
                aif=aif
            ),
            request,
        )

    if new_status == AifStatusChoices.AWAITING_VALIDATION:
        update_all_lines_status(
            status=AifLineStatusChoices.AWAITING_VALIDATION,
            aif=aif,
            request=request,
        )

    send_aif_status_notification(
        request=request,
        aif=aif,
        new_status=new_status,
        comment=comment,
    )

def notify_aif_approvers(request, aif, comment=None):
    responsibility = PROMOTION_CATEGORY_TO_RESPONSIBILITY.get(aif.promotion_category)

    if not responsibility:
        return

    product_groups = set(aif.aif_lines.values_list("product_group", flat=True))

    product_group_mail = ", ".join(sorted(product_groups))
    total_support = sum(
        aif.aif_lines.values_list("promotion_support", flat=True)
    )

    cc_mail = aif.email_cc if aif.email_cc else ""

    for product_group in product_groups:
        emails = list(
            AifApprover.objects.filter(
                product_group=product_group, responsibility=responsibility
            )
            .values_list("approver__email", flat=True)
            .distinct()
        )
        if not emails:
            continue

        send_emails(
            to=emails,
            cc=cc_mail,
            subject=f"Promotion Ref: {aif.aif_id} is awaiting Commercial Approval",
            body=f"""
                Dear PSBD Team,<br><br>

                The ONINVOICE promotion request is awaiting Commercial Approval,
                please approve within 24 hours.<br><br>

                <b>NSO:</b> {aif.nso}<br>
                <b>Product Group:</b> {product_group_mail}<br>
                <b>Requester:</b> {aif.meta_created_by.get_full_name()}<br>
                <b>Promo Campaign:</b> {aif.promotion_campaign or ''}<br>
                <b>Promo Category:</b> {aif.promotion_category or ''}<br>
                <b>Activity:</b> {aif.promotion_activity or ''}<br>
                <b>TTL Support:</b> {total_support:,.2f}<br><br>

                Please click the link below to review the promotion details:<br>
                <a href="{aif_url(request, aif.aif_id)}">
                    {aif_url(request, aif.aif_id)}
                </a>

                <br><br>

                Thanks<br>
                Kind Regards<br>
                Rev Sales Ops Team
            """,  
        )

class AifStatusView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]
    queryset = AifStatus.objects.all()
    serializer_class = AifStatusSerializer
    filter_backends = [
        DjangoFilterBackend,
        filters.SearchFilter,
        filters.OrderingFilter,
    ]
    filterset_fields = {"aif": ["exact"]}

    def perform_create(self, serializer):
        aif = serializer.validated_data["aif"]
        new_status = serializer.validated_data["status"]
        comment = serializer.validated_data.get("comment")

        current_status = get_aif_status(aif).status
        user_roles = get_user_roles(self.request.user)

        if not is_valid_aif_transition(
            current_status=current_status,
            new_status=new_status,
        ):
            raise PermissionDenied(
                f"Invalid AIF status transition from "
                f"{current_status} to {new_status}."
            )

        if not is_role_allowed_for_aif_status(
            user_roles=user_roles,
            target_status=new_status,
        ):
            raise PermissionDenied(
                "You are not allowed to perform "
                "this status transition."
            )

        update_aif_workflow(
            request=self.request,
            aif=aif,
            new_status=new_status,
            comment=comment,
        )

