    def conflicts(self, request, pk=None):
        aif = self.get_object()

        conflict_ids = get_conflicting_aif_ids(aif)

        return Response({
            "conflicting_rows": conflict_ids,
        })

    def get_serializer_class(self):
        if self.action in [
            "create",
            "update",
            "partial_update",
            "destroy",
        ]:
            return AifWriteSerializer

        return AifReadSerializer

    def perform_create(self, serializer):
        instance: Aif = serializer.save(
            meta_created_by=self.request.user,
            meta_edited_date=timezone.now(),
        )

        AifStatus.objects.create(
            aif=instance,
            status=AifStatusChoices.DRAFT,
            meta_created_by=self.request.user,
        )

        return instance

    def perform_update(self, serializer):
        current_status = get_aif_status(
            self.kwargs["pk"]
        )

        if current_status.status not in [
            AifStatusChoices.DRAFT,
            AifStatusChoices.INVALID,
        ]:
            raise PermissionDenied(
                "You can't edit this AIF!"
            )

        instance = serializer.save(
            meta_edited_date=timezone.now(),
            meta_edited_by=self.request.user,
        )

        if current_status.status == AifStatusChoices.INVALID:

            update_aif_workflow(
                request=self.request,
                aif=instance,
                new_status=AifStatusChoices.DRAFT,
            )

            update_all_lines_status(
                status=AifLineStatusChoices.DRAFT,
                aif=instance,
                request=self.request,
            )

        return instance

    def get_queryset(self):
        if self.request.user.groups.filter(
            name=NSO_USER
        ).exists():

            return Aif.objects.filter(
                nso__in=Organization.objects.filter(
                    cluster=self.request.user.cluster
                ).values_list(
                    "organization_name",
                    flat=True,
                )
            )

        if self.request.user.groups.filter(
            name=PSBD_TEAM_USER
        ).exists():

            allowed_product_groups = (
                AifApprover.objects.filter(
                    approver=self.request.user
                )
                .values_list(
                    "product_group",
                    flat=True,
                )
            )

            return (
                Aif.objects.filter(
                    aif_lines__product_group__in=
                    allowed_product_groups
                )
                .distinct()
            )

        return Aif.objects.all()



