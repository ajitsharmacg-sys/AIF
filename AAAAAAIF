def get_open_orders(aif):
    mercury_codes = list(
        aif.aif_lines.values_list(
            "mercury_code",
            flat=True,
        )
    )

    if not mercury_codes:
        return [], []

    customers = list(
        aif.aif_customer_lines.values_list(
            "oracle_cust_number",
            flat=True,
        )
    )

    pricing_date = aif.start_date

    mercury_placeholders = ",".join(
        ["%s"] * len(mercury_codes)
    )

    sql = f"""
        SELECT
            OPERATING_NAME,
            CAST(ORDERED_DATE AS DATE) AS ORDERED_DATE,
            ORDER_NUMBER,
            ORDER_LINE_NUMBER_DETAIL,
            PARTY_NUMBER,
            ORDERED_ITEM,
            CAST(PRICING_DATE AS DATE) AS PRICING_DATE,
            UNIT_LIST_PRICE,
            UNIT_SELLING_PRICE,
            CUST_PO_NUMBER,
            TRANSACTIONAL_CURR_CODE
        FROM dbo.OpenOrders_AIF
        WHERE
            CAST(PRICING_DATE AS DATE) = %s
            AND LEFT(ORDERED_ITEM, 8) IN ({mercury_placeholders})
    """

    params = [
        pricing_date,
        *mercury_codes,
    ]

    if customers:
        customer_placeholders = ",".join(
            ["%s"] * len(customers)
        )

        sql += (
            f" AND PARTY_NUMBER IN "
            f"({customer_placeholders})"
        )

        params.extend(customers)

    with connections["powerbi"].cursor() as cursor:
        cursor.execute(sql, params)

        columns = [
            column[0]
            for column in cursor.description
        ]

        rows = cursor.fetchall()

    return columns, rows


def create_open_orders_excel(columns, rows):
    wb = Workbook()

    ws = wb.active
    ws.title = "Open Orders"

    headers = [
        column.replace("_", " ").title()
        for column in columns
    ]

    ws.append(headers)

    for cell in ws[1]:
        cell.font = Font(bold=True)

    for row in rows:
        ws.append(row)

    for column_index, header in enumerate(
        headers,
        start=1,
    ):
        column_letter = get_column_letter(
            column_index
        )

        ws.column_dimensions[
            column_letter
        ].width = len(header) + 4

    ws.freeze_panes = "A2"

    buffer = BytesIO()

    wb.save(buffer)
    buffer.seek(0)

    return buffer


def prepare_open_orders_attachment(aif):
    columns, rows = get_open_orders(aif)

    if not rows:
        return None

    buffer = create_open_orders_excel(
        columns,
        rows,
    )

    encoded_file = base64.b64encode(
        buffer.getvalue()
    ).decode("utf-8")

    filename = (
        f"OpenOrders_AIF_{aif.aif_id}_"
        f"{timezone.now().strftime('%Y%m%d_%H%M')}.xlsx"
    )

    return {
        "Name": filename,
        "ContentBytes": encoded_file,
    }








