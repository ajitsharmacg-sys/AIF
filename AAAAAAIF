class AifLineStatusView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]

    queryset = AifLineStatus.objects.all()

    serializer_class = AifLinesStatusSerializer

    filter_backends = [
        DjangoFilterBackend,
        filters.SearchFilter,
        filters.OrderingFilter,
    ]

    def perform_create(self, serializer):
        aif_line = serializer.validated_data[
            "aif_line"
        ]

        new_status = serializer.validated_data[
            "status"
        ]

        current_status = (
            AifLineStatus.objects
            .filter(aif_line=aif_line)
            .order_by("-meta_created_date")
            .first()
        )

        if not current_status:
            raise PermissionDenied(
                "Current line status was not found."
            )

        user_roles = get_user_roles(
            self.request.user
        )

        if not is_valid_line_transition(
            current_status=current_status.status,
            new_status=new_status,
        ):
            raise PermissionDenied(
                f"Invalid line status transition from "
                f"{current_status.status} to {new_status}."
            )

        if not is_role_allowed_for_line_status(
            user_roles=user_roles,
            target_status=new_status,
        ):
            raise PermissionDenied(
                "You are not allowed to perform "
                "this line status transition."
            )

        instance: AifLineStatus = serializer.save(
            meta_created_by=self.request.user,
        )

        aif = instance.aif_line.aif

        new_aif_status = determine_aif_status(
            aif_lines=AifLines.objects.filter(
                aif=aif
            ),
            current_status=get_aif_status(aif).status,
        )

        update_aif_workflow(
            request=self.request,
            aif=aif,
            new_status=new_aif_status,
            comment=instance.comment,
        )


def get_aif_status(aif_id) -> AifStatus:
    status = (
        AifStatus.objects
        .filter(aif=aif_id)
        .order_by("-meta_created_date")
        .first()
    )

    if not status:
        raise PermissionDenied(
            "Current AIF status was not found."
        )

    return status


def determine_aif_status(
    aif_lines,
    current_status: str,
) -> str:

    all_statuses = {
        status: 0
        for status in AifLineStatusChoices.values
    }

    total_lines = 0

    for line in aif_lines:
        total_lines += 1

        latest_status = (
            AifLineStatus.objects
            .filter(aif_line=line)
            .order_by("-meta_created_date")
            .first()
        )

        if not latest_status:
            all_statuses[
                AifLineStatusChoices.DRAFT
            ] += 1
            continue

        all_statuses[
            latest_status.status
        ] += 1

    if not total_lines:
        return current_status

    if (
        all_statuses[
            AifLineStatusChoices.REJECTED
        ] > 0
    ):
        return AifStatusChoices.INVALID

    if (
        all_statuses[
            AifLineStatusChoices.CLOSED
        ] == total_lines
    ):
        return AifStatusChoices.CLOSED

    if (
        all_statuses[
            AifLineStatusChoices.APPROVED
        ] == total_lines
    ):
        return AifStatusChoices.COMMERCIALLY_APPROVED

    if (
        all_statuses[
            AifLineStatusChoices.AWAITING_VALIDATION
        ] == total_lines
    ):
        return AifStatusChoices.AWAITING_VALIDATION

    if (
        all_statuses[
            AifLineStatusChoices.DRAFT
        ] == total_lines
    ):
        return AifStatusChoices.DRAFT

    return current_status

