            aif_lines=AifLines.objects.filter(
                aif=aif
            ),
            current_status=get_aif_status(aif).status,
        )

        update_aif_workflow(
            request=self.request,
            aif=aif,
            new_status=new_aif_status,
            comment=instance.comment,
        )


def get_aif_status(aif_id) -> AifStatus:
    status = (
        AifStatus.objects
        .filter(aif=aif_id)
        .order_by("-meta_created_date")
        .first()
    )

    if not status:
        raise PermissionDenied(
            "Current AIF status was not found."
        )

    return status


def determine_aif_status(
    aif_lines,
    current_status: str,
) -> str:

    all_statuses = {
        status: 0
        for status in AifLineStatusChoices.values
    }

    total_lines = 0

    for line in aif_lines:
        total_lines += 1

        latest_status = (
            AifLineStatus.objects
            .filter(aif_line=line)
            .order_by("-meta_created_date")
            .first()
        )

        if not latest_status:
            all_statuses[
                AifLineStatusChoices.DRAFT
            ] += 1
            continue

        all_statuses[
            latest_status.status
        ] += 1

    if not total_lines:
        return current_status

    if (
        all_statuses[
            AifLineStatusChoices.REJECTED
        ] > 0
    ):
        return AifStatusChoices.INVALID

    if (
        all_statuses[
            AifLineStatusChoices.CLOSED
        ] == total_lines
    ):
        return AifStatusChoices.CLOSED

    if (
        all_statuses[
            AifLineStatusChoices.APPROVED
        ] == total_lines
    ):
        return AifStatusChoices.COMMERCIALLY_APPROVED

    if (
        all_statuses[
            AifLineStatusChoices.AWAITING_VALIDATION
        ] == total_lines
    ):
        return AifStatusChoices.AWAITING_VALIDATION

    if (
        all_statuses[
            AifLineStatusChoices.DRAFT
        ] == total_lines
    ):
        return AifStatusChoices.DRAFT

    return current_status

