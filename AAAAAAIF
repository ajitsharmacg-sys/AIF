def get_user_roles(user):
    return set(
        user.groups.values_list(
            "name",
            flat=True,
        )
    )



class AifView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]

    filter_backends = [
        DjangoFilterBackend,
        filters.SearchFilter,
        filters.OrderingFilter,
        AifByStatusFilter,
    ]

    pagination_class = StandardPagination

    filterset_fields = {
        "aif_id": ["exact"],
        "meta_created_date": [
            "exact",
            "gt",
            "lt",
        ],
    }

    search_fields = [
        "aif_id",
        "nso",
    ]

    @action(detail=True, methods=["get"])
    def conflicts(self, request, pk=None):
        aif = self.get_object()

        conflict_ids = get_conflicting_aif_ids(aif)

        return Response({
            "conflicting_rows": conflict_ids,
        })

    def get_serializer_class(self):
        if self.action in [
            "create",
            "update",
            "partial_update",
            "destroy",
        ]:
            return AifWriteSerializer

        return AifReadSerializer

    def perform_create(self, serializer):
        instance: Aif = serializer.save(
            meta_created_by=self.request.user,
            meta_edited_date=timezone.now(),
        )

        AifStatus.objects.create(
            aif=instance,
            status=AifStatusChoices.DRAFT,
            meta_created_by=self.request.user,
        )

        return instance

    def perform_update(self, serializer):
        current_status = get_aif_status(
            self.kwargs["pk"]
        )

        if current_status.status not in [
            AifStatusChoices.DRAFT,
            AifStatusChoices.INVALID,
        ]:
            raise PermissionDenied(
                "You can't edit this AIF!"
            )

        instance = serializer.save(
            meta_edited_date=timezone.now(),
            meta_edited_by=self.request.user,
        )

        if current_status.status == AifStatusChoices.INVALID:

            update_aif_workflow(
                request=self.request,
                aif=instance,
                new_status=AifStatusChoices.DRAFT,
            )

            update_all_lines_status(
                status=AifLineStatusChoices.DRAFT,
                aif=instance,
                request=self.request,
            )

        return instance

    def get_queryset(self):
        if self.request.user.groups.filter(
            name=NSO_USER
        ).exists():

            return Aif.objects.filter(
                nso__in=Organization.objects.filter(
                    cluster=self.request.user.cluster
                ).values_list(
                    "organization_name",
                    flat=True,
                )
            )

        if self.request.user.groups.filter(
            name=PSBD_TEAM_USER
        ).exists():

            allowed_product_groups = (
                AifApprover.objects.filter(
                    approver=self.request.user
                )
                .values_list(
                    "product_group",
                    flat=True,
                )
            )

            return (
                Aif.objects.filter(
                    aif_lines__product_group__in=
                    allowed_product_groups
                )
                .distinct()
            )

        return Aif.objects.all()



class AifStatusView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]

    queryset = AifStatus.objects.all()

    serializer_class = AifStatusSerializer

    filter_backends = [
        DjangoFilterBackend,
        filters.SearchFilter,
        filters.OrderingFilter,
    ]

    filterset_fields = {
        "aif": ["exact"],
    }

    def perform_create(self, serializer):
        aif = serializer.validated_data["aif"]

        new_status = serializer.validated_data[
            "status"
        ]

        comment = serializer.validated_data.get(
            "comment"
        )

        current_status = get_aif_status(
            aif
        ).status

        user_roles = get_user_roles(
            self.request.user
        )

        if not is_valid_aif_transition(
            current_status=current_status,
            new_status=new_status,
        ):
            raise PermissionDenied(
                f"Invalid AIF status transition from "
                f"{current_status} to {new_status}."
            )

        if not is_role_allowed_for_aif_status(
            user_roles=user_roles,
            target_status=new_status,
        ):
            raise PermissionDenied(
                "You are not allowed to perform "
                "this status transition."
            )

        update_aif_workflow(
            request=self.request,
            aif=aif,
            new_status=new_status,
            comment=comment,
        )


