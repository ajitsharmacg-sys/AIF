def fetch_open_orders(aif):
    mercury_codes = list(
        aif.aif_lines.values_list(
            "mercury_code",
            flat=True,
        )
    )

    if not mercury_codes:
        return None

    customers = list(
        aif.aif_customer_lines.values_list(
            "oracle_cust_number",
            flat=True,
        )
    )

    mercury_placeholders = ",".join(
        ["%s"] * len(mercury_codes)
    )

    sql = f"""
        SELECT
            OPERATING_NAME,
            CAST(ORDERED_DATE AS DATE) AS ORDERED_DATE,
            ORDER_NUMBER,
            ORDER_LINE_NUMBER_DETAIL,
            PARTY_NUMBER,
            ORDERED_ITEM,
            CAST(PRICING_DATE AS DATE) AS PRICING_DATE,
            UNIT_LIST_PRICE,
            UNIT_SELLING_PRICE,
            CUST_PO_NUMBER,
            TRANSACTIONAL_CURR_CODE
        FROM dbo.OpenOrders_AIF
        WHERE CAST(PRICING_DATE AS DATE) = %s
        AND LEFT(ORDERED_ITEM, 8) IN ({mercury_placeholders})
    """

    params = [aif.start_date, *mercury_codes]

    if customers:
        customer_placeholders = ",".join(
            ["%s"] * len(customers)
        )

        sql += (
            f" AND PARTY_NUMBER IN "
            f"({customer_placeholders})"
        )

        params.extend(customers)

    with connections["powerbi"].cursor() as cursor:
        cursor.execute(sql, params)

        columns = [
            column[0]
            for column in cursor.description
        ]

        rows = cursor.fetchall()

    if not rows:
        return None

    return columns, rows


def prepare_open_orders_attachment(aif):
    open_orders = fetch_open_orders(aif)

    if not open_orders:
        return None

    columns, rows = open_orders

    workbook = Workbook()
    worksheet = workbook.active
    worksheet.title = "Open Orders"

    headers = [
        column.replace("_", " ").title()
        for column in columns
    ]

    worksheet.append(headers)

    for cell in worksheet[1]:
        cell.font = Font(bold=True)

    for row in rows:
        worksheet.append(row)

    worksheet.freeze_panes = "A2"

    buffer = BytesIO()
    workbook.save(buffer)

    filename = (
        f"OpenOrders_AIF_{aif.aif_id}_"
        f"{timezone.now():%Y%m%d_%H%M}.xlsx"
    )

    return {
        "Name": filename,
        "ContentBytes": base64.b64encode(
            buffer.getvalue()
        ).decode("utf-8"),
    }









