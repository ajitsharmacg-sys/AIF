def get_workflow(disclosure_type):
    """
    Returns workflow definition.
    """
    return WORKFLOW_MATRIX.get(disclosure_type, {})


def get_next_status(disclosure_type, step):
    """
    Returns the awaiting status for the given workflow step.
    Returns None if workflow is complete.
    """
    return WORKFLOW_MATRIX.get(disclosure_type, {}).get(step)


def get_total_steps(disclosure_type):
    """
    Returns total approval steps.
    """
    return len(WORKFLOW_MATRIX.get(disclosure_type, {}))


def get_role_from_status(status):
    """
    Returns the role responsible for the current awaiting status.
    """
    return LINE_STATUS_TO_ROLE.get(status, [])


def get_role_status(role):
    """
    Returns the awaiting status assigned to the role.
    """
    return ROLE_TO_LINE_STATUS.get(role, [])


