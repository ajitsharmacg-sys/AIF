from django import forms

from predisclosure.models import (
    PreDisclosureApprover,
)

from predisclosure.workflow import (
    get_required_role,
)


class PreDisclosureApproverAdminForm(forms.ModelForm):

    class Meta:
        model = PreDisclosureApprover
        fields = (
            "approver_type",
            "approver",
        )

    def clean(self):
        cleaned_data = super().clean()

        approver = cleaned_data.get("approver")
        approver_type = cleaned_data.get("approver_type")

        if not approver or not approver_type:
            return cleaned_data

        required_role = get_required_role(
            approver_type
        )

        if (
            required_role
            and not approver.groups.filter(
                name=required_role
            ).exists()
        ):
            raise forms.ValidationError(
                f"{approver} is not assigned to "
                f"'{required_role}'."
            )

        return cleaned_data


