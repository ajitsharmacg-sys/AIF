def get_next_status(disclosure_type, product_category, current_status):
    workflow = WORKFLOW_MATRIX[disclosure_type][product_category]

    reverse = {v: k for k, v in workflow.items()}

    step = reverse.get(current_status)

    if step is None:
        return None

    return workflow.get(step + 1)


