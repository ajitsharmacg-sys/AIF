async paste_lines_from_excel(
    line_items,
    index,
    event
) {
    this.loading = true;

    const text =
        event.clipboardData.getData(
            "text/plain"
        );

    if (!text || !text.trim()) {
        this.loading = false;
        return;
    }

    const disclosure_type =
        String(
            this.selected_predisclosure
                ?.predisclosure_type ?? ""
        )
        .trim()
        .toUpperCase();

    if (!disclosure_type) {
        this.show_notification(
            "Please select a Disclosure Type before pasting Excel data."
        );

        this.loading = false;
        return;
    }

    const copied_lines =
        text
            .trim()
            .split(/\r?\n/)
            .filter(
                line => line.trim() !== ""
            );

    if (!copied_lines.length) {
        this.loading = false;
        return;
    }

    /*
     * First row contains Excel headers
     */
    const headers =
        copied_lines[0]
            .split("\t")
            .map(
                header => header.trim()
            );

    const field_mapping = [];

    /*
     * Map Excel headers with line field labels
     */
    for (
        let column_index = 0;
        column_index < headers.length;
        column_index++
    ) {
        const header =
            headers[column_index];

        const field =
            Object.keys(
                this.line_fields
            ).find(
                field_name =>
                    this.line_fields[
                        field_name
                    ].label
                        .trim()
                        .toLowerCase() ===
                    header
                        .toLowerCase()
            );

        if (!field) {
            continue;
        }

        field_mapping.push({
            column_index,
            field,
        });
    }

    if (!field_mapping.length) {
        this.show_notification(
            "No valid Pre-Disclosure columns were found in the pasted Excel data."
        );

        this.loading = false;
        return;
    }

    /*
     * Start reading data from second row
     */
    for (
        let row_index = 1;
        row_index < copied_lines.length;
        row_index++
    ) {
        const cells =
            copied_lines[row_index]
                .split("\t");

        const row = {
            id: "temp",
        };

        let has_value = false;

        for (
            const mapping of field_mapping
        ) {
            let value =
                cells[
                    mapping.column_index
                ];

            if (
                value === undefined ||
                value === null
            ) {
                value = "";
            }

            value =
                String(value).trim();

            if (value) {
                has_value = true;
            }

            /*
             * Invalid dropdown value:
             * Skip only this field
             */
            if (
                value &&
                !this.validate_pasted_value(
                    mapping.field,
                    value
                )
            ) {
                continue;
            }

            row[mapping.field] =
                value;
        }

        /*
         * Ignore completely blank rows
         */
        if (!has_value) {
            continue;
        }

        /*
         * Add pasted row
         */
        line_items.splice(
            index,
            0,
            row
        );

        /*
         * Track new lines in edit mode
         */
        if (
            this.nav_context.context === "edit"
        ) {
            this.changes
                .new_lines_count++;
        }

        index++;
    }

    this.loading = false;
},

validate_pasted_date(value) {
    const date_value =
        String(value ?? "").trim();

    if (
        !/^\d{2}\/\d{2}\/\d{4}$/.test(
            date_value
        )
    ) {
        return false;
    }

    const [
        day,
        month,
        year,
    ] =
        date_value
            .split("/")
            .map(Number);

    const date =
        new Date(
            year,
            month - 1,
            day
        );

    return (
        date.getFullYear() === year &&
        date.getMonth() === month - 1 &&
        date.getDate() === day
    );
},


validate_pasted_value(field, value) {
    const config =
        this.line_fields[field];

    if (!config) {
        return true;
    }

    const trimmed_value =
        String(value ?? "").trim();

    if (!trimmed_value) {
        return true;
    }

    /*
     * Dropdown validation
     */
    if (
        config.values?.length &&
        !config.values.includes(trimmed_value)
    ) {
        this.show_notification(
            `${config.label}: invalid value "${trimmed_value}". ` +
            "Please enter a valid value manually."
        );

        return false;
    }

    /*
     * Date validation
     */
    if (
        config.date &&
        !this.validate_pasted_date(trimmed_value)
    ) {
        this.show_notification(
            `${config.label}: invalid date "${trimmed_value}". ` +
            "Please use dd/mm/yyyy format."
        );

        return false;
    }

    return true;
},







