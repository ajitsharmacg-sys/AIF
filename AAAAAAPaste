prepare_line_fields(api_fields) {
    Object.keys(this.line_fields).forEach(field => {
        if (!api_fields[field]) {
            return;
        }

        const types =
            this.line_fields[field].types;

        this.line_fields[field] = {
            ...api_fields[field],
            types,
            values:
                api_fields[field].choices
                    ?.map(choice => choice.value),
            date:
                api_fields[field].type === "date",
        };
    });
},

created() {
    loadOptions(api_endpoints.predisclosure_line)
        .then(response => {
            if (!response.ok) {
                return Promise.reject(response);
            }

            return response.json();
        })
        .then(data => {
            console.log(
                "PreDisclosure Line Options:",
                data
            );

            if (data.actions?.POST) {
                this.options["predisclosure_line"] =
                    data.actions.POST;

                this.prepare_line_fields(this.options["predisclosure_line"]);
            }
        })
        .catch(error_response => {
            this.display_error(
                error_response,
                "Failed to load PreDisclosure Line Items"
            );
        });
},








