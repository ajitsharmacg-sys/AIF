             */
            const mandatory_error =
                this.validate_pasted_line(
                    row
                );

            if (mandatory_error) {
                this.show_notification(
                    `Row ${row_index + 1}: ${mandatory_error}`
                );
                continue;
            }

            /*
             * First pasted row updates
             * existing empty row
             */
            if (
                row_index === 1 &&
                line_items[index] &&
                this.is_empty_line(
                    line_items[index]
                )
            ) {
                Object.assign(
                    line_items[index],
                    row
                );
            } else {
                line_items.splice(
                    index,
                    0,
                    row
                );
            }

            /*
             * Edit mode tracking
             */
            if (
                this.nav_context.context === "edit"
            ) {
                line_items[index].id =
                    "temp";

                this.changes
                    .new_lines_count++;
            }

            index++;
        }
    } finally {
        this.loading = false;
    }
},


resetDisclosureFields() {
    const disclosure_type =
        String(
            this.selected_predisclosure
                ?.predisclosure_type ?? ""
        )
        .trim()
        .toUpperCase();

    let fields_to_reset = [];

    if (disclosure_type === "PARTNER") {
        fields_to_reset =
            this.end_customer_fields;
    }

    if (disclosure_type === "END_CUSTOMER") {
        fields_to_reset =
            this.partner_fields;
    }

    for (const line of this.lines) {
        for (const field of fields_to_reset) {
            line[field] = "";
        }
    }
},
