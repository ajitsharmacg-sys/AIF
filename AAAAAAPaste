},


get_download_datetime() {
    const now = new Date();

    const date =
        `${String(now.getDate()).padStart(2, "0")}-` +
        `${String(
            now.getMonth() + 1
        ).padStart(2, "0")}`;

    const time =
        `${String(now.getHours()).padStart(2, "0")}-` +
        `${String(now.getMinutes()).padStart(2, "0")}`;

    return `${date}_${time}`;
},


async download_line_template() {
    const disclosure_type =
        String(
            this.selected_predisclosure
                ?.predisclosure_type ?? ""
        )
        .trim()
        .toUpperCase();

    if (!disclosure_type) {
        this.show_notification(
            "Please select a Disclosure Type before downloading the template."
        );
        return;
    }

    const columns =
        this.predisclosure_line_columns;

    if (!columns.length) {
        this.show_notification(
            "PreDisclosure Line options are not loaded."
        );
        return;
    }

    const headers =
        columns.map(
            field => this.line_fields[field].label
        );

    /*
     * Main Template Sheet
     */
    const worksheet =
        utils.aoa_to_sheet([
            headers,
        ]);

    worksheet["!cols"] =
        columns.map(field => ({
            wch: Math.max(
                this.line_fields[field]
                    .label.length + 5,
                20
            ),
        }));

    /*
     * Help Sheet
     * Only dropdown fields and date
     */
    const help_fields = [
        "nda_confirmed",
        "disclosure_format",
        "sda_partner_level",
        "account_in_sda_partner_list",
        "disclosed_last_2_years",
        "meeting_date",
    ].filter(
        field => columns.includes(field)
    );

    const help_data = [
        help_fields.map(
            field => this.line_fields[field].label
        ),
    ];

    const max_rows =
        Math.max(
            ...help_fields.map(field => {
                const config =
                    this.line_fields[field];

                if (
                    config.values &&
                    config.values.length
                ) {
                    return config.values.length;
                }

                if (config.date) {
                    return 1;
                }

                return 0;
            }),
            1
        );

    for (
        let row_index = 0;
        row_index < max_rows;
        row_index++
    ) {
        help_data.push(
            help_fields.map(field => {
                const config =
                    this.line_fields[field];

                if (
                    config.values &&
                    config.values.length
                ) {
                    return (
                        config.values[row_index] ?? ""
                    );
                }

                if (
                    config.date &&
                    row_index === 0
                ) {
                    return "dd-mm-yyyy";
                }

                return "";
            })
        );
    }

    const help_worksheet =
        utils.aoa_to_sheet(help_data);

    help_worksheet["!cols"] =
        help_fields.map(field => ({
            wch: Math.max(
                this.line_fields[field]
                    .label.length + 5,
                25
            ),
        }));

    /*
     * Workbook
     */
    const workbook =
        utils.book_new();

    utils.book_append_sheet(
        workbook,
        worksheet,
        "PreDisclosure Lines"
    );

    utils.book_append_sheet(
        workbook,
        help_worksheet,
        "Help"
    );

    writeFile(
        workbook,
        `PreDisclosure_${disclosure_type}_${this.get_download_datetime()}_Template.xlsx`
    );
},


validate_pasted_line(line) {
    for (
        const field of Object.keys(
            this.line_fields
        )
    ) {
        const config =
            this.line_fields[field];

        if (!config.required) {
            continue;
        }

        const value =
            line[field];

        if (
            value === undefined ||
            value === null ||
            String(value).trim() === ""
        ) {
            return `${config.label} is required.`;
        }
    }

    return null;
},


validate_pasted_date(value) {
