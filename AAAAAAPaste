computed: {
    form_fields() {
        const disclosure_type =
            String(
                this.selected_predisclosure
                    ?.predisclosure_type ?? ""
            )
            .trim()
            .toUpperCase();

        const fields = [
            ...this.common_fields,
        ];

        if (disclosure_type === "PARTNER") {
            fields.push(
                ...this.partner_fields
            );
        }

        if (disclosure_type === "END_CUSTOMER") {
            fields.push(
                ...this.end_customer_fields
            );
        }

        return fields;
    },

    line_fields() {
        const api_fields =
            this.options["predisclosure_line"] || {};

        return Object.fromEntries(
            this.form_fields
                .filter(
                    field => api_fields[field]
                )
                .map(field => {
                    const option =
                        api_fields[field];

                    return [
                        field,
                        {
                            ...option,

                            values:
                                option.choices?.map(
                                    choice => choice.value
                                ) || [],

                            date:
                                option.type === "date",
                        },
                    ];
                })
        );
    },

    predisclosure_line_columns() {
        return Object.keys(
            this.line_fields
        );
    },

    lines() {
        return (
            this.selected_predisclosure
                ?.predisclosure_line ?? []
        );
    },

    is_edit_mode() {
        return (
            this.nav_context.context === "edit"
        );
    },
},


showField(fieldName) {
