def get_workflow(
    disclosure_type,
    product_category,
):
    """
    Return the configured workflow for the
    disclosure type and product category.

    Returns an empty dictionary if no workflow
    is configured.
    """

    return (
        WORKFLOW_MATRIX
        .get(disclosure_type, {})
        .get(product_category, {})
    )


