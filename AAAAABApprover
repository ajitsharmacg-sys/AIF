    users = UserModel.objects.filter(
        groups__name__in=[NSO_USER, ROLES, ADMIN_ROLE]
    ).distinct()

    users_to_display = []

    for user in users:
        u = {}
        u["email"] = user.email
        u["first_name"] = user.first_name
        u["last_name"] = user.last_name
        u["roles"] = []

        for group in user.groups.all():
            if app_prefix in group.name:
                u["roles"].append(group.name)

        u["roles"] = ", ".join(u["roles"])
        users_to_display.append(u)

    # Approver types configured for the logged-in user
    user_approver_types = list(
        PreDisclosureApprover.objects.filter(
            approver=request.user
        ).values_list(
            "approver_type",
            flat=True
        )
    )

    context = {
