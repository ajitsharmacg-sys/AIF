    ordering = ("-meta_created_date",)

    filterset_fields = {
        "line": ["exact"],
    }

    def perform_create(self, serializer):

        line = serializer.validated_data["line"]

        latest_status = (
            PreDisclosureLineStatus.objects
            .filter(line=line)
            .latest("meta_created_date")
        )

        # -------------------------------------------------
        # APPROVAL AUTHORIZATION
        #
        # Admin:
        #     Can approve/reject every phase.
        #
        # Normal approver:
        #     Must match the approver_type configured for
        #     the current status.
        #
        # No role-based approval check here.
        # -------------------------------------------------

        if not can_user_approve(
            self.request.user,
            latest_status.status,
