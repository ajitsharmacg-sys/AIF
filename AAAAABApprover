get_line_status_choices(line) {

    const current_status =
        line.predisclosure_line_status;

    if (!current_status) {
        return [];
    }

    const required_approver_type =
        this.STATUS_TO_APPROVER_TYPE[current_status];

    if (!required_approver_type) {
        return [];
    }

    const is_current_user_approver =
        this.USER_APPROVER_TYPES.includes(
            required_approver_type
        );

    if (!is_current_user_approver) {
        return [];
    }

    return [
        "APPROVED",
        "REJECTED",
    ];
