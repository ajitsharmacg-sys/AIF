from predisclosure.workflow import get_approver_stage_name

def get_previous_status(self, obj):
    statuses = list(
        obj.predisclosure_line_status
        .order_by("-meta_created_date")
    )

    for index, status in enumerate(statuses):

        if status.status in [
            PreDisclosureLineStatusChoices.APPROVED,
            PreDisclosureLineStatusChoices.REJECTED,
        ]:

            stage_name = ""

            if index + 1 < len(statuses):
                previous_status = statuses[index + 1].status

                stage_name = get_approver_stage_name(
                    previous_status
                )

            decision = status.status.title()

            if stage_name:
                return f"{decision} By {stage_name}"

            return decision

    return None




class PreDisclosureApproverAdminForm(EnhancedModelForm):

    class Meta:
        model = PreDisclosureApprover
        fields = (
            "approver_type",
            "approver",
        )

    def clean(self):
        cleaned_data = super().clean()

        approver = cleaned_data.get("approver")
        approver_type = cleaned_data.get("approver_type")

        if not approver or not approver_type:
            return cleaned_data

        # -------------------------------------------------
        # Check duplicate approver configuration
        # -------------------------------------------------

        if (
            PreDisclosureApprover.objects.filter(
                approver=approver,
                approver_type=approver_type,
            )
            .exclude(pk=self.instance.pk)
            .exists()
        ):
            raise forms.ValidationError(
                "This approver is already configured "
                "for the selected Approver Type."
            )

        return cleaned_data

