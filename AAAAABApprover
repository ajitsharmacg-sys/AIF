        PreDisclosureLineStatus.objects
        .filter(line=line)
        .latest("meta_created_date")
    )

    # Determine which approver type is required
    # for the current line status.
    required_approver_type = get_approver_type(
        latest_status.status
    )

    if not required_approver_type:
        raise PermissionDenied(
            "This line is not awaiting an approval action."
        )

    # Check whether the logged-in user is configured
    # as the required approver type.
    is_authorized = PreDisclosureApprover.objects.filter(
        approver=self.request.user,
        approver_type=required_approver_type,
    ).exists()

    if not is_authorized:
        raise PermissionDenied(
            "You are not authorized to approve or reject this line."
        )

    instance = serializer.save(
        meta_created_by=self.request.user
    )

    notification = self.request.data.get(
        "notification",
        ""
    )

    process_line_approval(
        self.request,
        instance,
        notification,
    )


def get_default_context(request):
