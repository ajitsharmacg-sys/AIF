def get_approver_type(status):
    """
    Return the approver type required for
    the supplied approval status.
    """

    return STATUS_TO_APPROVER_TYPE.get(
        status
    )


def get_required_role(approver_type):
    """
    Kept for compatibility with existing code.

    This should not be used for approval authorization.
    """

    return APPROVER_TYPE_TO_ROLE.get(
        approver_type
    )


def can_user_approve(
    user,
    current_status,
):
    """
    Check whether the logged-in user can approve/reject
    the current approval stage.

    Rules:

    1. ADMIN_ROLE can approve/reject any approval phase.
    2. Normal users must exist in PreDisclosureApprover
       with the approver_type required by current_status.

    No role-specific authorization is performed.

    Returns:
        True / False
    """

    # -----------------------------------------------------
    # Admin can approve/reject all phases
    # -----------------------------------------------------

    if user.groups.filter(
        name=ADMIN_ROLE
    ).exists():
        return True

    # -----------------------------------------------------
    # Get required approver type
    # -----------------------------------------------------

    required_approver_type = get_approver_type(
        current_status
    )

    if not required_approver_type:
        return False

    # -----------------------------------------------------
    # Check configured approver
    # -----------------------------------------------------

    return PreDisclosureApprover.objects.filter(
        approver=user,
        approver_type=required_approver_type,
    ).exists()


# =========================================================
# WORKFLOW TRANSITION GRAPH
# =========================================================

def get_workflow_transitions(
    disclosure_type,
    product_category,
):
    """
    Build the actual workflow transition graph
    from WORKFLOW_MATRIX.

    Example:

        STEP 1 -> STEP 2
        STEP 2 -> STEP 3
        STEP 3 -> []

    Returns a dictionary:

        {
            status1: [status2],
            status2: [status3],
            status3: [],
        }
    """

    workflow = get_workflow(
        disclosure_type,
        product_category,
    )

    if not workflow:
        return {}

    statuses = list(
        workflow.values()
    )

    transitions = {}

    for index, current_status in enumerate(
        statuses
    ):

        if index + 1 < len(statuses):
            transitions[current_status] = [
                statuses[index + 1]
            ]
        else:
            transitions[current_status] = []

    return transitions


def get_next_status(
    disclosure_type,
    product_category,
    current_status,
):
    """
    Return the next approval status.

    Returns None when the current status is
    the final configured approval stage or when
    the current status is not found.
    """

    transitions = get_workflow_transitions(
        disclosure_type,
        product_category,
    )

    next_statuses = transitions.get(
        current_status,
        [],
    )

    if not next_statuses:
        return None

    return next_statuses[0]


def is_valid_transition(
    disclosure_type,
    product_category,
    current_status,
    next_status,
):
    """
    Check whether a transition is valid for the
    configured disclosure type and product category.

    Returns True / False only.
    No exception is raised here.
    """

    transitions = get_workflow_transitions(
        disclosure_type,
        product_category,
    )

    return next_status in transitions.get(
        current_status,
        [],
    )


