def get_approver_stage_name(status):
    """
    Return the display name for the current
    approval stage.
    """

    approver_type = get_approver_type(
        status
    )

    return APPROVER_STAGE_NAME.get(
        approver_type,
        approver_type,
    )


def get_workflow_progress(
    disclosure_type,
    product_category,
    current_status,
):
    """
    Build workflow progress dynamically from
    WORKFLOW_MATRIX.

    Displays:

        ✓ Completed stages
        ➜ Current awaiting stage

    Future stages are not displayed.
    """

    workflow = get_workflow(
        disclosure_type,
        product_category,
    )

    if not workflow:
        return ""

    status_to_step = {
        status: step
        for step, status in workflow.items()
    }

    current_step = status_to_step.get(
        current_status
    )

    if current_step is None:
        return ""

    html = ""

    for step in sorted(
        workflow.keys()
    ):

        if step > current_step:
            break

        status = workflow[step]

        stage = get_approver_stage_name(
            status
        )

        if step < current_step:
            icon = "&#10004;"
            state = "Completed"
        else:
            icon = "&#10148;"
            state = "Awaiting"

        html += (
            f"{icon} "
            f"{stage} - "
            f"{state}<br>"
        )

    return html



