validate_pasted_value(field, value) {
    const config = this.line_fields[field];

    if (!config) {
        return true;
    }

    /*
     * Blank value
     *
     * Mandatory validation is handled separately.
     */
    if (
        value === undefined ||
        value === null ||
        String(value).trim() === ""
    ) {
        return true;
    }

    const trimmed_value =
        String(value).trim();


    /*
     * Dropdown validation
     */
    if (config.values) {
        if (
            !config.values.includes(
                trimmed_value
            )
        ) {
            this.show_notification(
                `${config.label}: invalid value "${value}". ` +
                `Please enter a valid value manually.`
            );

            return false;
        }
    }


    /*
     * Date validation
     */
    if (config.date) {
        const date_pattern =
            /^\d{2}-\d{2}-\d{4}$/;

        if (
            !date_pattern.test(
                trimmed_value
            )
        ) {
            this.show_notification(
                `${config.label}: invalid date "${value}". ` +
                `Please use dd-mm-yyyy format.`
            );

            return false;
        }

        const [
            day,
            month,
            year
        ] =
            trimmed_value
                .split("-")
                .map(Number);

        const date =
            new Date(
                year,
                month - 1,
                day
            );

        /*
         * Check that the date really exists.
         *
         * This prevents:
         * 31-02-2026
         * 32-01-2026
         * 00-05-2026
         */
        if (
            date.getFullYear() !== year ||
            date.getMonth() !== month - 1 ||
            date.getDate() !== day
        ) {
            this.show_notification(
                `${config.label}: invalid date "${value}". ` +
                `Please use a valid date in dd-mm-yyyy format.`
            );

            return false;
        }
    }

    return true;
},

validate_mandatory_fields(line) {
    const disclosure_type =
        String(
            this.selected_predisclosure?.predisclosure_type ?? ""
        ).trim().toUpperCase();

    for (
        const field of Object.keys(
            this.line_fields
        )
    ) {
        const config =
            this.line_fields[field];

        /*
         * Ignore fields not applicable
         * to the selected disclosure type.
         */
        if (
            !config.types.includes(
                disclosure_type
            )
        ) {
            continue;
        }

        /*
         * Ignore optional fields.
         */
        if (!config.mandatory) {
            continue;
        }

        const value = line[field];

        if (
            value === undefined ||
            value === null ||
            String(value).trim() === ""
        ) {
            return (
                `${config.label} is mandatory.`
            );
        }
    }

    return null;
},



