validate_line(line) {
    const disclosure_type =
        this.selected_predisclosure.predisclosure_type;

    for (const field of Object.keys(this.line_fields)) {
        const config = this.line_fields[field];

        if (!config.types.includes(disclosure_type)) {
            continue;
        }

        if (
            config.mandatory &&
            (
                line[field] === undefined ||
                line[field] === null ||
                String(line[field]).trim() === ""
            )
        ) {
            return `${config.label} is mandatory.`;
        }
    }

    return null;
},





