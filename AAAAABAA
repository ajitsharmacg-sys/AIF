showField(fieldName) {
    const disclosure_type =
        this.selected_predisclosure.predisclosure_type;

    // Initial load - no disclosure type selected
    // Show all fields.
    if (!disclosure_type) {
        return true;
    }

    return this.line_fields[fieldName]?.types.includes(
        disclosure_type
    );
},




predisclosure_line_columns() {
    const disclosure_type =
        this.selected_predisclosure.predisclosure_type;

    // Initial load - show all columns
    if (!disclosure_type) {
        return Object.keys(this.line_fields);
    }

    return Object.keys(this.line_fields).filter(
        field =>
            this.line_fields[field].types.includes(
                disclosure_type
            )
    );
},


async download_line_template() {

    const columns = this.predisclosure_line_columns;
    const headers = columns.map(
        field => this.line_fields[field].label
    );

    const worksheet = utils.aoa_to_sheet([
        headers,
    ]);

    worksheet["!cols"] = columns.map(
        field => ({
            wch: Math.max(
                this.line_fields[field].label.length + 3,
                20
            ),
        })
    );

    const workbook = utils.book_new();

    utils.book_append_sheet(
        workbook,
        worksheet,
        "PreDisclosure Lines"
    );

    writeFile(
        workbook,
        "PreDisclosure_Line_Template.xlsx"
    );
},


