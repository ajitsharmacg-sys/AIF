class ProductGroupOperationUnit(models.Model):
    product_group = models.CharField(max_length=100, unique=True)
    operation_unit = models.CharField(max_length=100)

    is_active = models.BooleanField(default=True)

    class Meta:
        db_table = "product_group_operation_unit"
        ordering = ["product_group"]

    def __str__(self):
        return f"{self.product_group} - {self.operation_unit}"


@admin.register(ProductGroupOperationUnit)
class ProductGroupOperationUnitAdmin(admin.ModelAdmin):
    list_display = (
        "product_group",
        "operation_unit",
        "is_active",
    )
    list_filter = ("is_active",)
    search_fields = (
        "product_group",
        "operation_unit",
    )


class ProductGroupOperationUnitSerializer(
    serializers.ModelSerializer
):
    class Meta:
        model = ProductGroupOperationUnit
        fields = [
            "product_group",
            "operation_unit",
        ]


class ProductGroupOperationUnitViewSet(
    viewsets.ReadOnlyModelViewSet
):
    queryset = ProductGroupOperationUnit.objects.filter(
        is_active=True
    )
    serializer_class = ProductGroupOperationUnitSerializer



router.register(
    r"product-group-operation-unit",
    ProductGroupOperationUnitViewSet,
    basename="product-group-operation-unit",
)


async load_product_group_operation_units() {
    try {
        const response = await fetch(
            this.api_endpoints.product_group_operation_unit
        );

        if (!response.ok) {
            throw new Error(
                "Unable to load Product Group Operation Unit mapping."
            );
        }

        const data = await response.json();

        this.product_group_operation_units = {};

        data.forEach(item => {
            this.product_group_operation_units[
                item.product_group
            ] = item.operation_unit;
        });

    } catch (error) {
        console.error(
            "Error loading Product Group Operation Unit mapping:",
            error
        );

        this.show_notification(
            "Unable to load Product Group Operation Unit mapping."
        );
    }
},



getOperationUnitForLine(line, defaultOpUnit) {
    const configuredOpUnit =
        this.product_group_operation_units[
            line?.product_group
        ];

    return configuredOpUnit || defaultOpUnit;
},


