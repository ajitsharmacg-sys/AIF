<div class="card-body p-2">

    <div class="table-responsive predisclosure-table-wrapper">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >

            <table class="table table-sm table-bordered mb-0 predisclosure-table">

                <thead>
                    ...
                </thead>

                <tbody>

                    <tr
                        v-for="(line, index) in lines"
                        :key="'predisclosure-line-' + index"
                    >

                        <td class="sticky-col sticky-index text-center align-middle">
