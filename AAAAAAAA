<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>
            Account Details
        </strong>

        <export-excel-button
            title="Download Pre-Disclosure Template"
            @click="download_line_template()">
        </export-excel-button>

    </div>


    <div class="card-body p-2">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >

            <div
                v-for="(line, index) in lines"
                :key="'line-' + index"
                class="card mb-3"
            >

                <!-- ACCOUNT HEADER -->

                <div class="card-header py-2 d-flex justify-content-between align-items-center">

                    <strong>
                        Account #[[ index + 1 ]]
                    </strong>

                    <div class="btn-group">

                        <template-button
                            :size="18"
                            @click="copy_line(line, index)">
                        </template-button>

                        <delete-button
                            :size="18"
                            @delete-confirm="delete_line(line)">
                        </delete-button>

                    </div>

                </div>


                <div class="card-body p-3">


                    <!-- =========================
                         ROW 1 - MAIN DETAILS
                    ========================== -->

                    <div class="row g-2 mb-3">

                        <div class="col-md-2">
                            <label class="form-label small mb-1">
                                Account Name
                            </label>

                            <!-- account_name field -->
                        </div>


                        <div class="col-md-2">
                            <label class="form-label small mb-1">
                                Website Name
                            </label>

                            <!-- website field -->
                        </div>


                        <div class="col-md-2">
                            <label class="form-label small mb-1">
                                Is NDA Confirmed
                            </label>

                            <!-- is_nda_confirmed field -->
                        </div>


                        <div class="col-md-2">
                            <label class="form-label small mb-1">
                                Pre Disclosure Format
                            </label>

                            <!-- pre_disclosure_format field -->
                        </div>


                        <div class="col-md-2">
                            <label class="form-label small mb-1">
                                Meeting Date
                            </label>

                            <!-- meeting_date field -->
                        </div>


                        <div class="col-md-2">
                            <label class="form-label small mb-1">
                                Disclosed In Last 2 years
                            </label>

                            <!-- disclosed_last_2_years field -->
                        </div>

                    </div>


                    <!-- =========================
                         ROW 2 - BUSINESS DETAILS
                    ========================== -->

                    <div class="row g-2 mb-3">

                        <div class="col-md-3">
                            <label class="form-label small mb-1">
                                B2B Business Type
                            </label>

                            <!-- b2b_business_type field -->
                        </div>


                        <div class="col-md-3">
                            <label class="form-label small mb-1">
                                Estimated Business
                            </label>

                            <!-- estimated_business field -->
                        </div>


                        <div class="col-md-3">
                            <label class="form-label small mb-1">
                                Annual Sales
                            </label>

                            <!-- annual_sales field -->
                        </div>


                        <div class="col-md-3">
                            <label class="form-label small mb-1">
                                SDA Partner Level
                            </label>

                            <!-- sda_partner_level field -->
                        </div>

                    </div>


                    <!-- =========================
                         ROW 3 - TEXTAREAS
                    ========================== -->

                    <div class="row g-2">

                        <div class="col-md-4">

                            <label class="form-label small mb-1">
                                Disclosure Reason
                            </label>

                            <!-- disclosure_reason field -->

                        </div>


                        <div class="col-md-4">

                            <label class="form-label small mb-1">
                                Meeting Location
                            </label>

                            <!-- meeting_location field -->

                        </div>


                        <div class="col-md-4">

                            <label class="form-label small mb-1">
                                Canon Responsible Person
                            </label>

                            <!-- canon_responsible_person field -->

                        </div>


                        <div class="col-md-6">

                            <label class="form-label small mb-1">
                                Individual Disclosure Names
                            </label>

                            <!-- individual_disclosure_names field -->

                        </div>


                        <div class="col-md-6">

                            <label class="form-label small mb-1">
                                Information Disclosure
                            </label>

                            <!-- information_disclosure field -->

                        </div>

                    </div>


                </div>

            </div>

        </form>


        <!-- ADD ACCOUNT -->

        <div class="mt-2">

            <add-button
                :size="18"
                @click="add_line()">
            </add-button>

        </div>

    </div>

</div>
