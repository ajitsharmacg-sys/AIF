<div class="card">

	<div class="card-header d-flex justify-content-between align-items-center">

		<strong>Account Details</strong>

		<div class="d-flex gap-2">

			<export-excel-button
				title="Download Pre-Disclosure Template"
				@click="download_line_template()">
			</export-excel-button>

		</div>

	</div>


	<div class="card-body p-2">

		<div class="table-responsive">

			<form
				id="predisclosure_line_form"
				@submit.prevent=""
			>

				<table class="table table-sm table-bordered mb-0">

					<thead>

						<tr class="align-top">

							<th>
								#
							</th>


							{% for field in predisclosure_line_form.visible_fields %}

								<th
									v-if="showField('{{ field.name }}')"
								>

									{{ field.label }}

								</th>

							{% endfor %}


							<th>
								Actions
							</th>

						</tr>

					</thead>


					<tbody>

						<template
							v-for="(line, index) in lines"
							:key="'predisclosure-line-' + index"
						>

							<tr>

								<td class="align-middle text-center">

									[[ index + 1 ]]

								</td>


								{% for field in predisclosure_line_form.visible_fields %}

									<td
										v-if="showField('{{ field.name }}')"
										class="align-middle"
									>

										{{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

									</td>

								{% endfor %}


								<td class="align-middle">

									<div
										class="btn-group"
										role="group"
									>

										<template-button
											:size="18"
											@click="copy_line(line, index)">
										</template-button>


										<delete-button
											:size="18"
											@delete-confirm="delete_line(line)">
										</delete-button>

									</div>

								</td>

							</tr>

						</template>


						<!-- ADD BUTTON ROW -->

						<tr>

							<td>

								<add-button
									:size="18"
									@click="add_line()">
								</add-button>

							</td>

						</tr>

					</tbody>

				</table>

			</form>

		</div>

	</div>

</div>
