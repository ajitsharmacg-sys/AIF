<div class="card">

    <!-- MAIN CARD HEADER -->

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Pre-Disclosure Details</strong>

        <div class="d-flex gap-2">

            <export-excel-button
                title="Download Pre-Disclosure Template"
                @click="download_line_template()">
            </export-excel-button>

        </div>

    </div>


    <!-- MAIN CARD BODY -->

    <div class="card-body p-2">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >

            <!-- TWO TABLES -->

            <div class="row g-2">

                <!-- ========================= -->
                <!-- ACCOUNT DETAILS TABLE -->
                <!-- ========================= -->

                <div class="col-md-4">

                    <div class="card h-100">

                        <div class="card-header py-2">

                            <strong>Account Details</strong>

                        </div>


                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table
                                    class="table table-sm table-bordered align-middle mb-0"
                                >

                                    <!-- HEADER -->

                                    <thead class="table-secondary">

                                        <tr>

                                            <th
                                                class="text-center"
                                                style="width: 50px;"
                                            >
                                                #
                                            </th>


                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name == "account_name" or field.name == "website" %}

                                                    <th
                                                        v-if="showField('{{ field.name }}')"
                                                    >

                                                        {{ field.label }}

                                                    </th>

                                                {% endif %}

                                            {% endfor %}

                                        </tr>

                                    </thead>


                                    <!-- BODY -->

                                    <tbody>

                                        <tr
                                            v-for="(line, index) in lines"
                                            :key="'account-' + index"
                                        >

                                            <!-- SERIAL -->

                                            <td class="text-center">

                                                [[ index + 1 ]]

                                            </td>


                                            <!-- ACCOUNT FIELDS -->

                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name == "account_name" or field.name == "website" %}

                                                    <td
                                                        v-if="showField('{{ field.name }}')"
                                                        class="p-1"
                                                    >

                                                        {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                                    </td>

                                                {% endif %}

                                            {% endfor %}

                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>



                <!-- ========================= -->
                <!-- DISCLOSURE DETAILS TABLE -->
                <!-- ========================= -->

                <div class="col-md-8">

                    <div class="card h-100">

                        <div class="card-header py-2">

                            <strong>Disclosure Details</strong>

                        </div>


                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table
                                    class="table table-sm table-bordered align-middle mb-0"
                                >

                                    <!-- HEADER -->

                                    <thead class="table-secondary">

                                        <tr>

                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name != "account_name" and field.name != "website" %}

                                                    <th
                                                        v-if="showField('{{ field.name }}')"
                                                        class="text-nowrap"
                                                    >

                                                        {{ field.label }}

                                                    </th>

                                                {% endif %}

                                            {% endfor %}


                                            <!-- ACTION -->

                                            <th class="text-center">

                                                Actions

                                            </th>

                                        </tr>

                                    </thead>


                                    <!-- BODY -->

                                    <tbody>

                                        <tr
                                            v-for="(line, index) in lines"
                                            :key="'disclosure-' + index"
                                        >

                                            <!-- DISCLOSURE FIELDS -->

                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name != "account_name" and field.name != "website" %}

                                                    <td
                                                        v-if="showField('{{ field.name }}')"
                                                        class="p-1"
                                                    >

                                                        {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                                    </td>

                                                {% endif %}

                                            {% endfor %}


                                            <!-- ACTIONS -->

                                            <td class="text-center">

                                                <div
                                                    class="btn-group"
                                                    role="group"
                                                >

                                                    <template-button
                                                        :size="18"
                                                        @click="copy_line(line, index)">
                                                    </template-button>


                                                    <delete-button
                                                        :size="18"
                                                        @delete-confirm="delete_line(line)">
                                                    </delete-button>

                                                </div>

                                            </td>

                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- SINGLE ADD BUTTON -->

            <div class="mt-2">

                <add-button
                    :size="18"
                    @click="add_line()">
                </add-button>

            </div>

        </form>

    </div>

</div>
