<div class="card">

    <!-- MAIN HEADER -->

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>
            Account Details
        </strong>

        <div class="d-flex gap-2">

            <export-excel-button
                title="Download Pre-Disclosure Template"
                @click="download_line_template()">
            </export-excel-button>

        </div>

    </div>


    <div class="card-body p-2">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >

            <!-- ACCOUNT CARDS -->

            <div
                v-for="(line, index) in lines"
                :key="'line-' + index"
                class="card mb-3"
            >


                <!-- ACCOUNT HEADER -->

                <div
                    class="card-header py-2 d-flex justify-content-between align-items-center"
                >

                    <strong>
                        Account #[[ index + 1 ]]
                    </strong>


                    <div class="btn-group">

                        <template-button
                            :size="18"
                            @click="copy_line(line, index)">
                        </template-button>


                        <delete-button
                            :size="18"
                            @delete-confirm="delete_line(line)">
                        </delete-button>

                    </div>

                </div>


                <!-- ACCOUNT BODY -->

                <div class="card-body py-3">

                    <!--
                        6 COLUMN RESPONSIVE GRID

                        Normal fields = 1 column
                        Textarea fields = 2 columns
                    -->

                    <div class="row g-3">


                        {% for field in predisclosure_line_form.visible_fields %}


                            {% if field.field.widget.template_name == "django/forms/widgets/textarea.html" %}


                                <!-- TEXTAREA FIELD : SPANS 2 COLUMNS -->

                                <div
                                    v-if="showField('{{ field.name }}')"
                                    class="col-12 col-md-6 col-xl-4"
                                >

                                    <label class="form-label small mb-1">

                                        {{ field.label }}

                                    </label>


                                    {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                </div>


                            {% else %}


                                <!-- NORMAL FIELD -->

                                <div
                                    v-if="showField('{{ field.name }}')"
                                    class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2"
                                >

                                    <label class="form-label small mb-1">

                                        {{ field.label }}

                                    </label>


                                    {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                </div>


                            {% endif %}


                        {% endfor %}


                    </div>

                </div>

            </div>

        </form>


        <!-- ADD ACCOUNT -->

        <div class="mt-2">

            <add-button
                :size="18"
                @click="add_line()">
            </add-button>

        </div>

    </div>

</div>
