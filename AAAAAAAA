<div class="card">

    <!-- MAIN HEADER -->

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Pre-Disclosure Details</strong>

        <export-excel-button
            title="Download Pre-Disclosure Template"
            @click="download_line_template()">
        </export-excel-button>

    </div>


    <!-- MAIN BODY -->

    <div class="card-body p-2">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >

            <div class="row g-2">

                <!-- ================================= -->
                <!-- ACCOUNT DETAILS TABLE -->
                <!-- ================================= -->

                <div class="col-md-4">

                    <div class="card h-100">

                        <div class="card-header py-2">
                            <strong>Account Details</strong>
                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table table-bordered table-sm mb-0">

                                    <thead class="text-bg-secondary">

                                        <tr>

                                            <th>#</th>

                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name == "account_name" or field.name == "website_name" %}

                                                    <th>
                                                        {{ field.label }}
                                                    </th>

                                                {% endif %}

                                            {% endfor %}

                                        </tr>

                                    </thead>


                                    <tbody>

                                        <tr
                                            v-for="(line, index) in lines"
                                            :key="'account-' + index"
                                        >

                                            <td>
                                                [[ index + 1 ]]
                                            </td>


                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name == "account_name" or field.name == "website_name" %}

                                                    <td>

                                                        {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                                    </td>

                                                {% endif %}

                                            {% endfor %}

                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================= -->
                <!-- DISCLOSURE DETAILS TABLE -->
                <!-- ================================= -->

                <div class="col-md-8">

                    <div class="card h-100">

                        <div class="card-header py-2">
                            <strong>Disclosure Details</strong>
                        </div>


                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table table-bordered table-sm mb-0">

                                    <thead class="text-bg-secondary">

                                        <tr>

                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name != "account_name" and field.name != "website_name" %}

                                                    <th>

                                                        {{ field.label }}

                                                        {% if field.help_text %}
                                                            <br>
                                                            <small class="form-text">
                                                                {{ field.help_text|safe }}
                                                            </small>
                                                        {% endif %}

                                                    </th>

                                                {% endif %}

                                            {% endfor %}

                                            <th>
                                                Actions
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        <tr
                                            v-for="(line, index) in lines"
                                            :key="'disclosure-' + index"
                                        >

                                            {% for field in predisclosure_line_form.visible_fields %}

                                                {% if field.name != "account_name" and field.name != "website_name" %}

                                                    <td>

                                                        {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                                    </td>

                                                {% endif %}

                                            {% endfor %}


                                            <!-- ACTIONS -->

                                            <td>

                                                <div
                                                    class="btn-group"
                                                    role="group"
                                                >

                                                    <template-button
                                                        :size="18"
                                                        @click="copy_line(line, index)">
                                                    </template-button>


                                                    <delete-button
                                                        :size="18"
                                                        @delete-confirm="delete_line(line, index)">
                                                    </delete-button>

                                                </div>

                                            </td>

                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ADD BUTTON -->

            <div class="mt-2">

                <add-button
                    :size="18"
                    @click="add_line()">
                </add-button>

            </div>

        </form>

    </div>

</div>
