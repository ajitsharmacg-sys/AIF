<div class="card">

    <!-- CARD HEADER -->
    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Account Details</strong>

        <div class="d-flex gap-2">

            <export-excel-button
                title="Download Pre-Disclosure Template"
                @click="download_line_template()">
            </export-excel-button>

        </div>

    </div>


    <div class="card-body p-2">

        <form
            id="predisclosure_line_form"
            @submit.prevent=""
        >

            <!-- RESPONSIVE TABLE -->

            <div class="table-responsive">

                <table
                    class="table table-bordered table-sm align-middle mb-0"
                >

                    <!-- TABLE HEADER -->

                    <thead class="table-light">

                        <tr>

                            <!-- SERIAL NUMBER -->

                            <th
                                class="text-center"
                                style="width: 50px;"
                            >
                                #
                            </th>


                            <!-- DYNAMIC FIELDS -->

                            {% for field in predisclosure_line_form.visible_fields %}

                                <th
                                    v-if="showField('{{ field.name }}')"
                                    class="text-nowrap"
                                >

                                    {{ field.label }}

                                </th>

                            {% endfor %}


                            <!-- ACTION -->

                            <th
                                class="text-center text-nowrap"
                                style="width: 100px;"
                            >
                                Action
                            </th>

                        </tr>

                    </thead>


                    <!-- TABLE BODY -->

                    <tbody>

                        <tr
                            v-for="(line, index) in lines"
                            :key="'line-' + index"
                        >

                            <!-- SERIAL NUMBER -->

                            <td class="text-center">

                                [[ index + 1 ]]

                            </td>


                            <!-- DYNAMIC FORM FIELDS -->

                            {% for field in predisclosure_line_form.visible_fields %}

                                <td
                                    v-if="showField('{{ field.name }}')"
                                    class="p-1"
                                    style="min-width: 180px;"
                                >

                                    {{ field|add_attrs:":index=index;v-model=lines;@change=handle_line_change(lines,index,$event);@paste.prevent=paste_lines_from_excel(lines,index,$event)" }}

                                </td>

                            {% endfor %}


                            <!-- ACTION BUTTONS -->

                            <td class="text-center p-1">

                                <div
                                    class="btn-group"
                                    role="group"
                                >

                                    <template-button
                                        :size="18"
                                        @click="copy_line(line, index)">
                                    </template-button>


                                    <delete-button
                                        :size="18"
                                        @delete-confirm="delete_line(line)">
                                    </delete-button>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </form>


        <!-- ADD BUTTON -->

        <div class="mt-2">

            <add-button
                :size="18"
                @click="add_line()">
            </add-button>

        </div>

    </div>

</div>
