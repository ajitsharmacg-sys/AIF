from common.forms import (
    Select,
    EnhancedModelForm,
    DatalistSelectPredefinedWidget,
)

from django.forms import (
    TextInput,
    Textarea,
    Select,
    DateInput,
)

from predisclosure.models import PreDisclosureLine


class PreDisclosureLineForm(EnhancedModelForm):

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)

        # ==============================
        # ACCOUNT NAME
        # ==============================

        distinct_accounts = sorted(
            list(
                PreDisclosureLine.objects.exclude(
                    account_name__isnull=True
                )
                .exclude(
                    account_name=""
                )
                .values_list(
                    "account_name",
                    flat=True,
                )
                .distinct()
            )
        )

        self.fields["account_name"].widget = (
            DatalistSelectPredefinedWidget(
                attrs={
                    "class": "form-control form-control-sm",
                },
                choices=[
                    (account, account)
                    for account in distinct_accounts
                ],
            )
        )

        # ==============================
        # WEBSITE
        # ==============================

        distinct_website = sorted(
            list(
                PreDisclosureLine.objects.exclude(
                    website__isnull=True
                )
                .exclude(
                    website=""
                )
                .values_list(
                    "website",
                    flat=True,
                )
                .distinct()
            )
        )

        self.fields["website"].widget = (
            DatalistSelectPredefinedWidget(
                attrs={
                    "class": "form-control form-control-sm",
                },
                choices=[
                    (website, website)
                    for website in distinct_website
                ],
            )
        )

        # ==============================
        # TEXTAREA FIELDS
        # ==============================

        textarea_fields = [
            "reason_for_disclosure",
            "meeting_location",
            "canon_responsible_person",
            "individuals_being_disclosed_to",
            "information_to_be_disclosed",
        ]

        for field_name in textarea_fields:

            if field_name in self.fields:

                self.fields[field_name].widget = Textarea(
                    attrs={
                        "class": "form-control form-control-sm",
                        "rows": 2,
                    }
                )

        # ==============================
        # DATE FIELD
        # ==============================

        if "meeting_date" in self.fields:

            self.fields["meeting_date"].widget = DateInput(
                attrs={
                    "class": "form-control form-control-sm",
                    "type": "date",
                }
            )

        # ==============================
        # APPLY BOOTSTRAP CLASS
        # TO REMAINING FIELDS
        # ==============================

        for field_name, field in self.fields.items():

            # Skip fields already configured
            if field_name in [
                "account_name",
                "website",
                *textarea_fields,
                "meeting_date",
            ]:
                continue

            widget = field.widget

            existing_class = widget.attrs.get("class", "")

            # Select fields
            if isinstance(widget, forms.Select):

                widget.attrs.update({
                    "class": (
                        existing_class
                        or "form-select form-select-sm"
                    )
                })

            # Other input fields
            else:

                widget.attrs.update({
                    "class": (
                        existing_class
                        or "form-control form-control-sm"
                    )
                })


    class Meta:

        model = PreDisclosureLine

        fields = [
            "account_name",
            "website",
            "nda_confirmed",
            "disclosure_format",
            "reason_for_disclosure",
            "meeting_date",
            "meeting_location",
            "canon_responsible_person",
            "individuals_being_disclosed_to",
            "information_to_be_disclosed",
            "sda_partner_level",
            "account_in_sda_partner_list",
            "retailer_ranking",
            "disclosed_last_2_years",
            "b2b_business_type",
            "estimated_business",
            "annual_sales",
        ]

